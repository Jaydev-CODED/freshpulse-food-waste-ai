# Database (PostgreSQL in Docker / production; SQLite fallback works out-of-the-box locally)
DATABASE_URL=sqlite:///./freshpulse.db
# DATABASE_URL=postgresql+psycopg2://freshpulse:freshpulse@postgres:5432/freshpulse

# External Real-Time Data Feeds
WEATHER_LATITUDE=19.0760
WEATHER_LONGITUDE=72.8777
WEATHER_LOCATION_NAME=Mumbai Retail Hub
HOLIDAY_COUNTRY_CODE=IN
KAGGLE_GROCERIES_FEED_URL=https://raw.githubusercontent.com/stedy/Machine-Learning-with-R-datasets/master/groceries.csv

# MLOps
MLFLOW_TRACKING_URI=./mlruns
AUTO_ROLLBACK_MAE_TOLERANCE=1.05
DRIFT_PSI_THRESHOLD=0.20
